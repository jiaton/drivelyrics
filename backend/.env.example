# Where browsers reach the app. Google's and every user's Spotify redirect URI, and the
# pairing QR code, are built from it. http:// (local dev) turns off Secure cookies.
PUBLIC_BASE_URL=https://drivelyrics.com

# Encrypts Spotify client secrets and tokens at rest. Generate once, never change
# (changing it makes every stored secret unreadable — users would re-enter them):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID, type "Web application"). Authorized redirect URI:
#   https://drivelyrics.com/api/auth/google/callback
# Empty = Google sign-in disabled (QR pairing then needs a phone signed in some other way).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: GitHub OAuth App (callback PUBLIC_BASE_URL/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: sign-in codes by email through Resend
RESEND_API_KEY=
MAIL_FROM=DriveLyrics <signin@example.com>

# The admin account; the pre-multi-user Spotify link and preferences migrate to it.
OWNER_EMAIL=

# Local development only: POST /api/auth/dev-login signs in as any email. Never in prod.
DEV_LOGIN=false

# Pre-multi-user Spotify app: only read by the one-time migration that moves the
# existing link to OWNER_EMAIL. Safe to delete once that has run in production.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional second lyrics source: a NeteaseCloudMusicApi-compatible service you run yourself
# (search + lyric endpoints). Leave empty to use LRCLIB only. See the README.
NETEASE_API_BASE_URL=

# SQLite file inside the backend-data volume (see docker-compose.yml)
DATABASE_PATH=/app/data/lyric.db

# How often a user's poller calls Spotify's currently-playing endpoint while a track is active
POLL_INTERVAL_SECONDS=4

# Now-playing feed webhooks go only to public HTTPS addresses. Comma-separated hosts exempt
# from that (plain HTTP and private addresses allowed), e.g. Home Assistant on your LAN.
FEED_WEBHOOK_ALLOW_HOSTS=
