{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drivelyrics.com/docs/feed/v1/link-poll-result.schema.json",
  "properties": {
    "status": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "With approved: the new feed token, handed out this once.",
      "title": "Token"
    }
  },
  "required": [
    "status"
  ],
  "title": "LinkPollResult",
  "type": "object"
}
